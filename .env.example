# --- LLM (Groq) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
ROUTER_MODEL=openai/gpt-oss-20b

# --- Stores ---
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./data/qdrant_local   # embedded Qdrant instead of the server
QDRANT_COLLECTION=paper_chunks
DATABASE_URL=postgresql+pg8000://researchhelp:researchhelp@localhost:5433/researchhelp

# --- Models (local, FastEmbed / ONNX) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ONNX_DEVICE=auto              # auto | cuda | cpu  (cuda needs: uv sync --extra gpu)

# --- Chunking / retrieval hyperparameters ---
RETRIEVAL_STRATEGY=hybrid_rerank   # semantic | hybrid | hybrid_rerank
MIN_PER_PAPER=1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
K_PER_PAPER=8
K_CANDIDATES=10
K_FINAL=6

# --- Paths ---
DATA_DIR=./data
